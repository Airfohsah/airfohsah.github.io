# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# build outputs — GitHub rejects anything over 100MB, and these are
# regenerated by `expo prebuild`/`eas build --local` every time anyway
*.apk
*.aab
mapping.txt

# release signing — local-only, never committed. Losing these means you can
# never publish an update under the same app identity again; back them up
# somewhere safe outside git (see README).
*.keystore
keystore.properties
